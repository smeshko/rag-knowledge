# Docker infra (compose only)
# Postgres superuser created by the postgres container on first boot.
POSTGRES_USER=postgres
# Password for POSTGRES_USER; also set as the default DB user password.
POSTGRES_PASSWORD=postgres
# Initial database created by the postgres container.
POSTGRES_DB=rag_recipes
# Shared by the app's REDIS_URL credentials and Langfuse's REDIS_AUTH env var.
REDIS_PASSWORD=redis

# Database / cache
# Async SQLAlchemy DSN (postgresql+asyncpg://...) used by the API and worker.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/rag_recipes
# Redis DSN consumed by arq for job queueing. The password segment must match
# REDIS_PASSWORD above — Settings rejects credential-less DSNs.
REDIS_URL=redis://:redis@localhost:6379/0
# Optional. Used by the integration tests; created automatically on first run.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/rag_recipes_test

# LLM (OpenAI SDK)
# OpenAI API key used by the LLM and embedding providers.
OPENAI_API_KEY=
# Chat / extraction model identifier.
LLM_MODEL=
# Max retries for transient rate_limit_exceeded 429s (>=0; 0 disables retries).
# LLM_MAX_RATE_LIMIT_RETRIES=5
# Per-request timeout in seconds for LLM chat completions (>=1).
# LLM_REQUEST_TIMEOUT_SECONDS=60
# Embedding model identifier.
# EMBEDDING_MODEL=text-embedding-3-small
# Embedding vector width — must match the pgvector column dimensions.
# EMBEDDING_DIMENSIONS=
# Inputs per OpenAI embeddings request (1–2048; smaller batches retry-safer).
# EMBEDDING_BATCH_SIZE=100

# Langfuse (self-hosted observability)
# Base URL of the self-hosted Langfuse deployment.
LANGFUSE_HOST=http://localhost:3001
# Public key for Langfuse SDK init. Matches LANGFUSE_INIT_PROJECT_PUBLIC_KEY.
LANGFUSE_PUBLIC_KEY=pk-lf-dev-public-key
# Secret key for Langfuse SDK init. Matches LANGFUSE_INIT_PROJECT_SECRET_KEY.
LANGFUSE_SECRET_KEY=sk-lf-dev-secret-key
# Toggle Langfuse instrumentation (true/false).
LANGFUSE_ENABLED=true

# Langfuse infra (compose only) — dev-safe seeds, not real secrets.
# Langfuse's own Postgres (separate from the app DB).
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=langfuse
LANGFUSE_POSTGRES_DB=langfuse
# ClickHouse credentials used by langfuse-worker / langfuse-web.
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# MinIO root credentials backing Langfuse's S3-compatible blob storage.
LANGFUSE_MINIO_ROOT_USER=minio
LANGFUSE_MINIO_ROOT_PASSWORD=miniosecret

# Langfuse crypto (compose only) — dev-safe seeds, not real secrets.
# NextAuth session-cookie secret (≥ 32 chars).
LANGFUSE_NEXTAUTH_SECRET=devnextauthsecretdevnextauthsecret
# Field-level encryption key for Langfuse (must be 64-char hex).
LANGFUSE_ENCRYPTION_KEY=9dcc0660684c0948a2461ee04b68b4c90752730024bbe75621f47693b6ee4621
# Per-deployment salt for Langfuse password hashing (≥ 32 chars).
LANGFUSE_SALT=devsaltvaluedevsaltvaluedevsaltvalue

# Langfuse auto-bootstrap (compose only) — provisions org / project / user
# on first boot when the Langfuse Postgres is empty. Rotating these values
# requires `just clean` to drop langfuse-postgres-data.
LANGFUSE_INIT_ORG_ID=rag-recipes-dev
LANGFUSE_INIT_ORG_NAME=rag-recipes-dev
LANGFUSE_INIT_PROJECT_ID=rag-recipes-dev
LANGFUSE_INIT_PROJECT_NAME=rag-recipes-dev
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-dev-public-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-dev-secret-key
LANGFUSE_INIT_USER_EMAIL=dev@rag-recipes.local
LANGFUSE_INIT_USER_NAME=Dev
LANGFUSE_INIT_USER_PASSWORD=devdevdev

# Auth (Epic 6)
# Personal bearer token gating the entire API. Auth fails closed: when this
# is empty, every request — including /api/v1/health — returns 401. Set
# this to use the API locally; send it as `Authorization: Bearer <token>`.
PERSONAL_API_TOKEN=

# Debug
# When true, mounts debug-only routes (e.g., span inspection).
# DEBUG_ENDPOINTS_ENABLED=

# Storage
# Root directory for the local file-storage provider.
LOCAL_STORAGE_ROOT=

# PDF chunking (doc 3)
# Page-window size for the sliding extraction context (default 3).
# PDF_WINDOW_SIZE_PAGES=
# Overlap between consecutive page windows (default 1).
# PDF_OVERLAP_PAGES=
# Windows committed per batch in the resumable extraction loop (Epic 9 Phase
# 9.5). On a crash, at most this many minus one windows are re-extracted on
# resume (>=1, default 5).
# EXTRACTION_COMMIT_BATCH_SIZE=5
# Minimum extracted chars before a page is flagged sparse (confidence=0.0) for
# later OCR (doc 11 § 2, default 20).
# PDF_MIN_TEXT_CHARS_FOR_PAGE=
# Identity of the production PDF text extractor (method + build), stamped onto each
# source_version's spans so the Epic 11.2 `auto` reprocess selector can detect an
# extractor change (default "pymupdf:embedded_text").
# PDF_TEXT_EXTRACTOR=

# LLM extraction soft-validation thresholds (Epic 9 Phase 9.3, doc 4 § Soft
# validation). Review heuristics, not calibrated truth: a candidate below a
# confidence floor or outside the char band is persisted as needs_review.
# Minimum recipe-level overall confidence before needs_review (0..1, default 0.5).
# EXTRACTION_MIN_OVERALL_CONFIDENCE=0.5
# Minimum recipe-boundary confidence before needs_review (0..1, default 0.5).
# EXTRACTION_MIN_BOUNDARY_CONFIDENCE=0.5
# Minimum (lowest) ingredient normalization confidence (0..1, default 0.5).
# EXTRACTION_MIN_NORMALIZATION_CONFIDENCE=0.5
# Body-text length band; outside it the recipe is flagged too short / too long.
# Max must exceed min (default 200..20000).
# EXTRACTION_MIN_RECIPE_CHARS=200
# EXTRACTION_MAX_RECIPE_CHARS=20000

# Search defaults (doc 7 / Epic 1 Phase 1.3)
# Default number of results returned by /search.
# SEARCH_DEFAULT_LIMIT=
# Top-K candidates pulled from the keyword (BM25/tsvector) leg.
# SEARCH_KEYWORD_TOP_K=
# Top-K candidates pulled from the vector leg.
# SEARCH_VECTOR_TOP_K=
# RRF fusion constant.
# SEARCH_RRF_K=

# Chunk-type boosts (doc 7)
# Keyword score boost for recipe title chunks.
# RECIPE_KEYWORD_BOOST_TITLE=
# Keyword score boost for recipe ingredients chunks.
# RECIPE_KEYWORD_BOOST_INGREDIENTS=
# Vector score boost for recipe summary chunks.
# RECIPE_VECTOR_BOOST_SUMMARY=

# Worker (Epic 7) — arq runtime knobs. Defaults serialise PyMuPDF access
# until Epic 8.1 lands per-extractor serialisation.
# Concurrent jobs per worker (>=1).
# WORKER_MAX_JOBS=1
# Per-job timeout in seconds (>=1).
# WORKER_JOB_TIMEOUT_SECONDS=600
# How long arq retains result payloads in Redis (>=0).
# WORKER_KEEP_RESULT_SECONDS=60
# Worker heartbeat interval in seconds (>=1).
# WORKER_HEALTH_CHECK_INTERVAL_SECONDS=30

# Stuck-job recovery (Epic 7 Phase 7.2) — policy knobs enforced by the
# sweep_stuck_jobs cron registered on the worker.
# Minutes a document may stay in a non-terminal status before the sweep
# marks it failed with reason "stuck_job_timeout" (>=1).
# STUCK_JOB_TIMEOUT_MINUTES=30
# Sweep cadence in minutes. Must divide 60 — valid values:
# 1, 2, 3, 4, 5, 6, 10, 12, 15, 20, 30, 60.
# STUCK_JOB_CHECK_INTERVAL_MINUTES=5
